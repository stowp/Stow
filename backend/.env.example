# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/insightarena

# Database Connection Pool Configuration (#418)
# Maximum number of connections in the pool (default: 20)
DB_POOL_MAX=20
# Minimum number of connections to maintain in the pool (default: 5)
DB_POOL_MIN=5
# Maximum time (ms) a connection can be idle before being released (default: 30000)
DB_POOL_IDLE_TIMEOUT_MS=30000
# Maximum time (ms) to wait for a connection from the pool (default: 10000)
DB_POOL_CONNECTION_TIMEOUT_MS=10000
# Maximum lifetime (seconds) of a connection before it's retired (default: 1800)
DB_POOL_MAX_LIFETIME_SECONDS=1800
# Connection leak detection threshold in ms - warns if connection held longer (default: 60000)
DB_POOL_LEAK_DETECTION_MS=60000
# Statement timeout in ms to prevent long-running queries (default: 30000)
DB_STATEMENT_TIMEOUT_MS=30000
# Maximum query execution time in ms for logging slow queries (default: 5000)
DB_MAX_QUERY_EXECUTION_TIME_MS=5000
# Application name for PostgreSQL connection tracking (default: stow-backend)
DB_APPLICATION_NAME=stow-backend

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=7d

# Stellar/Soroban Configuration
STELLAR_NETWORK=testnet
SOROBAN_CONTRACT_ID=CABC123456789DEFGHIJKLMNOPQRSTUVWXYZ123456789012345678
USDC_TOKEN_ADDRESS=CDEF123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ123456789012345
YIELD_ADAPTER_CONTRACT_ID=CXYZ123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ123456789012345
SERVER_SECRET_KEY=your-stellar-secret-key-here

# Server Configuration
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
# Comma-separated allowed browser origins. Defaults to FRONTEND_URL when unset.
CORS_ORIGINS=http://localhost:3001
# Use this exact callback URL in each OAuth provider console.
OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/callback

# Optional social sign-in credentials. Social identities must be linked to an
# existing wallet account in Settings before they can be used to sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Apple .p8 private key; newlines can be written as \n.
APPLE_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Reconciliation Configuration
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MS=60000
RECONCILE_WINDOW=200

# Soroban RPC retry policy (transient failures only — 5xx/429/network errors)
# Total number of attempts before giving up (1 initial + retries).
# Default: 3 (i.e. initial attempt plus up to 2 retries)
SOROBAN_RPC_MAX_RETRIES=3
# Base delay in milliseconds for exponential backoff between retry attempts.
# Delay formula: SOROBAN_RPC_RETRY_BASE_DELAY_MS * 4^attemptIndex → 500 ms, 2 s, 8 s
# Default: 500
SOROBAN_RPC_RETRY_BASE_DELAY_MS=500

# Leaderboard Snapshot Configuration
LEADERBOARD_SNAPSHOT_CRON=0 * * * *
LEADERBOARD_SNAPSHOT_RETENTION_DAYS=30

# Idempotency Key Configuration
IDEMPOTENCY_KEY_TTL_HOURS=24

# Rate-Limit Tier Configuration (#1367)
RATE_LIMIT_DEFAULT_TTL_MS=60000
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_AUTH_TTL_MS=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_READ_TTL_MS=60000
RATE_LIMIT_READ_LIMIT=200
RATE_LIMIT_WRITE_TTL_MS=60000
RATE_LIMIT_WRITE_LIMIT=30

# Audit logging
# 32-byte key that encrypts audit logs (REQUIRED). Generate one with:
#   openssl rand -hex 32
AUDIT_LOG_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# 32-byte key that encrypts TOTP secrets for two-factor auth. Generate with:
#   openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# Days to keep audit logs before they are purged (default 365)
AUDIT_LOG_RETENTION_DAYS=365

# Email / SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
EMAIL_FROM=notifications@insightarena.app
# Public base URL of this API, used for the unsubscribe link in emails
API_PUBLIC_URL=http://localhost:3000
# Maximum emails sent per minute (sliding-window rate limit)
EMAIL_RATE_LIMIT_PER_MINUTE=30

# Email retry policy (transient failures only — 5xx/429/network errors)
# Total number of send attempts before giving up (1 initial + retries).
# Default: 3 (i.e. initial attempt plus up to 2 retries)
EMAIL_RETRY_MAX_ATTEMPTS=3
# Base delay in milliseconds for exponential backoff between retry attempts.
# Delay formula: EMAIL_RETRY_BASE_DELAY_MS * 4^attemptIndex → 1000 ms, 4000 ms, 16000 ms
# Default: 1000 (1 second)
EMAIL_RETRY_BASE_DELAY_MS=1000

# Auth endpoint rate limiting
# Maximum number of POST /auth/verify requests allowed per IP within the time window.
AUTH_THROTTLE_LIMIT=5
# Time window in milliseconds for the auth throttle bucket.
AUTH_THROTTLE_TTL_MS=60000

# WebAuthn / Passkey Configuration
# User-visible relying party name shown in the browser's passkey prompt.
WEBAUTHN_RP_NAME=Stow
# Relying party ID: the domain (no scheme/port) passkeys are scoped to.
WEBAUTHN_RP_ID=localhost
# Expected origin of the frontend that completes the WebAuthn ceremony.
WEBAUTHN_ORIGIN=http://localhost:3000

# Digest Configuration
DIGEST_ENABLED=true
# Hour of the day (0-23, UTC) at which daily digests are sent
DIGEST_DAILY_HOUR_UTC=8
# Day of the week (0=Sunday … 6=Saturday) on which weekly digests are sent
DIGEST_WEEKLY_DAY=1

# Prediction Fraud Signal Thresholds (advisory only - no auto-enforcement)
# Minimum number of a user's predictions required before the timing
# clustering signal is evaluated.
FRAUD_TIMING_MIN_SAMPLE=5
# Consecutive predictions submitted within this many seconds of each other
# count as "clustered".
FRAUD_TIMING_CLUSTER_WINDOW_SECONDS=30
# Fraction (0-1) of a user's submission gaps that must be clustered to raise
# a timing clustering flag.
FRAUD_TIMING_CLUSTER_MIN_RATIO=0.6
# Minimum number of distinct markets a user must have predicted on before
# the counterparty concentration signal is evaluated.
FRAUD_COUNTERPARTY_MIN_MARKETS=5
# Herfindahl-Hirschman Index threshold (0-1) over counterparty market
# co-participation share; higher means more concentrated on a small clique.
FRAUD_COUNTERPARTY_HHI_THRESHOLD=0.5

# Dispute SLA Configuration
DISPUTE_SLA_ENABLED=true
# Hours a pending dispute has for its initial review before it escalates.
DISPUTE_SLA_INITIAL_REVIEW_HOURS=48
# Additional hours granted once a dispute escalates past initial review.
DISPUTE_SLA_ESCALATION_HOURS=24
# How many hours before a stage deadline to send an "approaching" notice.
DISPUTE_SLA_APPROACHING_WINDOW_HOURS=6
# Minimum hours between repeat "still breached" notifications once a
# dispute is in its terminal escalated stage.
DISPUTE_SLA_REESCALATION_INTERVAL_HOURS=24

# Live Odds WebSocket Channel (#1361)
# Maximum broadcast frequency per market in milliseconds (default: 500 ms).
ODDS_THROTTLE_MS=500

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ─── Partner Roundup API (#647) ──────────────────────────────────────────────
# Per-partner rate-limit: requests per window (default 60)
PARTNER_ROUNDUP_THROTTLE_LIMIT=60
# Rate-limit window in milliseconds (default 60 000 = 1 minute)
PARTNER_ROUNDUP_THROTTLE_TTL_MS=60000
# Minor-unit boundary for rounding (default 10 000 000 = $1 in stroops)
PARTNER_ROUNDUP_UNIT=10000000
# Maximum round-up per transaction in minor units (default 100 000 000 = $10)
PARTNER_ROUNDUP_MAX_AMOUNT=100000000
# Global fallback webhook URL called after every roundup (optional)
PARTNER_WEBHOOK_URL=
# Global HMAC-SHA256 secret for signing partner webhook callbacks (optional)
PARTNER_WEBHOOK_SECRET=
# Per-partner overrides (replace <PARTNER_ID_UPPER> with partner API-key UUID,
# dashes replaced by underscores and uppercased):
# PARTNER_<PARTNER_ID_UPPER>_WEBHOOK_URL=https://partner.example.com/hooks/roundup
# PARTNER_<PARTNER_ID_UPPER>_WEBHOOK_SECRET=change-me-to-a-random-secret
